<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mneme.Assistant</PackageId>
    <Title>Mneme.Assistant</Title>
    <Description>Personal-assistant domain profile for Mneme (satellite package). Adds a first-class agenda/attention ontology — waiting-on dependencies, commitments, and appointments — that a read-only assistant daemon discovers from bounded source batches and surfaces as non-authoritative candidates, with capability-guarded agenda queries (e.g. "what am I waiting on, from whom, overdue?"). Candidate-first: nothing is a user-accepted decision. Depends on the base Mneme package.</Description>
    <PackageTags>memory;agent;ai;assistant;productivity;agenda;waiting-on;commitments;mneme;profile</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Satellite depends on the published base Mneme package (which folds in
         Mneme.Contracts). Contracts is referenced directly for compile access
         but with PrivateAssets="all" so it does NOT become a phantom package
         dependency — at runtime the base Mneme package already carries
         Mneme.Contracts.dll (same pattern as Mneme.Writer.csproj). -->
    <ProjectReference Include="..\Mneme\Mneme.csproj" />
    <ProjectReference Include="..\Mneme.Contracts\Mneme.Contracts.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
